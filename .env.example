APP_NAME=BHASHA SETU
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Set to "backup" to use the public MADLAD-400 fallback.
BHASHA_MODEL_BACKEND=indictrans2
BHASHA_MODEL_NAME=ai4bharat/indictrans2-indic-indic-dist-320M
BHASHA_BACKUP_MODEL_NAME=google/madlad400-3b-mt

# Set to "true" only when running the test suite.
TESTING=false
